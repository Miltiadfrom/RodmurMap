# Порт и адрес, на котором слушает атлас
PORT=8080
HOST=0.0.0.0

# Пароль хранителя. Если не задан, сервер создаст его сам и напечатает в журнал запуска.
# Заданное значение применяется при каждом старте (перезаписывает сохранённый хэш).
RODMUR_ADMIN_PASSWORD=

# Где живут данные атласа и где лежит статика клиента
RODMUR_DATA_DIR=data
RODMUR_CLIENT_DIR=client

# Только для пересборки подложки (npm run generate)
# FMG_DIR=.cache/fmg
# RODMUR_DENSITY=6
# RODMUR_SEED=rodmur-tale-1
